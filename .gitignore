# Python
__pycache__/
*.py[cod]
.pytest_cache/
# Versioned venvs (.venv, .venv311, .venv3.12, ...) - the exact minor version is
# part of the directory name, so .venv/ alone does not match them.
.venv*/
venv*/
*.egg-info/

# Node / frontend builds
node_modules/
dist/
dist-ssr/

# Local env / secrets (never commit real secrets - use .env.example as template)
.env
.env.local
.env.*.local

# Local development databases and logs
*.sqlite3
*.log

# Generated module databases - rebuilt by each module's seed script, never a
# source artefact. Listed explicitly because the generic *.sqlite3 rule above
# does not cover the .db suffix these modules use.
module-*/national_data_mesh.db
module-*/civic_intelligence.db
module-*/ai_understanding.db
module-*/civic_processing.db
module-*/priority_recommendation.db
module-*/synthetic_intelligence.db
citizen_requests.db
module-*/citizen_requests.db

# OS / editor
.DS_Store
.vscode/
.idea/

# Runtime state from scripts/start-all.sh: pidfiles and service logs.
.run/
