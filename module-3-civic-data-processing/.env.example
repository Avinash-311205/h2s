# ---------------------------------------------------------------------------
# Module 3 - Civic Data Processing
# Copy this file to `.env` and adjust the values for your environment.
# Never commit the real `.env` file.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=niti-setu-civic-data-processing
ENVIRONMENT=development
API_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_JSON=true

# --- Database --------------------------------------------------------------
# Local development defaults to SQLite so the module runs with zero setup.
# For the full platform use PostgreSQL + PostGIS (see docker-compose.yml).
DATABASE_URL=sqlite:///./civic_processing.db
# DATABASE_URL=postgresql://civic:civic123@localhost:5433/civic_processing
AUTO_CREATE_SCHEMA=true
POSTGIS_ENABLED=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true

# --- Event publishing (Module 4 integration) -------------------------------
# redis | noop
EVENT_PUBLISHER=redis
REDIS_URL=redis://localhost:6379/0
EVENT_CHANNEL=civic.records.processed
EVENT_PUBLISH_MAX_RETRIES=3
EVENT_RETRY_BACKOFF_SECONDS=0.5
EVENT_OUTBOX_BATCH_SIZE=100

# --- Geocoding -------------------------------------------------------------
# mock | nominatim | chain   (chain = primary with configured fallback)
GEOCODING_PROVIDER=mock
GEOCODING_FALLBACK_PROVIDER=mock
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_TIMEOUT_SECONDS=5.0
GEOCODING_USER_AGENT=niti-setu-civic-data-processing/0.1 (contact: platform@example.gov.in)
GEOCODING_CACHE_TTL_SECONDS=3600
GEOCODING_NEAREST_PLACE_RADIUS_KM=60

# --- Deduplication / issue grouping ---------------------------------------
# rule_based (deterministic) | embedding (future ML/embedding matcher)
DEDUP_STRATEGY=rule_based
DEDUP_RADIUS_METERS=1000
DEDUP_TIME_WINDOW_HOURS=720
DEDUP_DESCRIPTION_SIMILARITY_THRESHOLD=0.30
DEDUP_MIN_MATCH_SCORE=0.55

# --- Security / limits -----------------------------------------------------
MAX_REQUEST_BYTES=262144
MAX_DESCRIPTION_LENGTH=5000
MAX_TEXT_FIELD_LENGTH=1000
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200
